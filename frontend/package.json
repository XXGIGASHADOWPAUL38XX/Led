{
  "name": "led-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "api:generate": "mkdir -p node_modules/.cache && (cd .. && ${PYTHON:-.venv/bin/python} -m backend.api.openapi) > node_modules/.cache/openapi.json && openapi-typescript node_modules/.cache/openapi.json -o src/api/schema.d.ts --array-length --default-non-nullable false",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/schema.d.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@msgpack/msgpack": "^3.1.3",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-query": "5.104.5",
    "@xyflow/react": "^12.12.0",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "type": "module",
  "overrides": {
    "@redocly/openapi-core": "1.34.21",
    "uri-js-replace": "1.0.1"
  }
}
